# ============================================
# AI CLOSET SCANNER - BACKEND CONFIGURATION
# ============================================
# Copy this file to .env and fill in your API keys

# -------------------- Anthropic (Claude) --------------------
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# -------------------- ElevenLabs (Voice) --------------------
# Get your API key from: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# -------------------- Google Gemini (Nano Banana) --------------------
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# -------------------- Tigris Storage --------------------
# Get your credentials from: https://console.tigris.dev/
TIGRIS_ENDPOINT=https://fly.storage.tigris.dev
TIGRIS_ACCESS_KEY=tid_your_access_key_here
TIGRIS_SECRET_KEY=tsec_your_secret_key_here
TIGRIS_BUCKET_NAME=closet-scanner-backups

# -------------------- Brex (Optional) --------------------
# Get your API key from: https://developer.brex.com/
BREX_API_KEY=your_brex_key_here

# -------------------- Galileo Observability --------------------
# Get your API key from: https://console.galileo.ai/
GALILEO_API_KEY=your_galileo_key_here
GALILEO_PROJECT_NAME=closet-scanner

# -------------------- Application Settings --------------------
# Your Daytona backend URL (update after deployment)
BACKEND_URL=http://localhost:8000
ENVIRONMENT=development

# -------------------- Security --------------------
# Generate a secure secret key for JWT tokens
SECRET_KEY=your-super-secret-key-change-this-in-production
